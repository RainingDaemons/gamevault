# Example environment configuration. Copy to `.env` (or export in your shell)
# and fill in real values. Never commit `.env`.

# Argon2id hash of the shared password.
# Generate one with: pnpm hash:password "your-password"
# IMPORTANT: escape every `$` in the hash as `\$` (e.g. `\$argon2id\$v=19\$...`),
# otherwise Vite will strip them when loading the .env file.
PASSWORD_HASH=

# Random 32+ byte secret used to sign session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Production mode (sets `secure` cookies, expects HTTPS via reverse proxy).
NODE_ENV=production

# Display name of the vault owner, shown in the header.
owner_name=

# Optional: override the markdown source path (defaults to `content/servers.md`).
# SERVERS_MD_PATH=

# Optional (behind a reverse proxy): header that carries the real client IP for
# rate limiting. Caddy/Traefik set `x-forwarded-for` by default.
# ADDRESS_HEADER=x-forwarded-for
